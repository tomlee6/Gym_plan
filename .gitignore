# This repository tracks backend/, web/, mobile/, shared/ and infra/.
# Everything else in this folder is local working material.

# Specification and design documents
/*.docx
/*.pdf

# Standalone HTML prototypes
/*.html


# OS and editor junk
.DS_Store
Thumbs.db
*.swp
*~
# Office's lock files while a document is open
~$*
# Python's compiled caches
__pycache__/
*.pyc

# --- backend ---
backend/node_modules/
backend/data/
backend/.env

# --- web ---
web/node_modules/
web/dist/
web/.env

# --- mobile (Flutter) ---
mobile/build/
mobile/.dart_tool/
mobile/.idea/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/*.iml
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/ephemeral/
mobile/ios/.symlinks/
mobile/macos/Pods/
mobile/macos/Flutter/ephemeral/
mobile/linux/flutter/ephemeral/
mobile/windows/flutter/ephemeral/
mobile/packages/*/build/
mobile/packages/*/.dart_tool/
