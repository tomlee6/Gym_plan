# Development: where Vite forwards /v1 calls (the backend's `npm run dev`).
GYM_PLAN_API=http://localhost:8080

# ---------------------------------------------------------------------------
# Build-time settings (read by src/config.js and vite.config.js). All optional.
# ---------------------------------------------------------------------------

# The backend's public URL, when the page is hosted on a different origin
# from the API. Leave unset if a reverse proxy serves /v1 on the same origin
# as this page. Its origin is also added to the CSP's connect-src.
# VITE_API_URL=https://api.gym.goalcert.example

# GoalCert Hub overrides. Normally unset: the page asks the backend
# (GET /v1/auth/hub/config), so the Hub client is configured in one place.
# Set them only to point a build at a different Hub than the API reports.
# VITE_HUB_CLIENT_ID=flex-gym-web
# VITE_HUB_AUTHORIZE_URL=https://hub.goalcert.example/oauth/authorize

# Extra origins the page may fetch from, space-separated, added to the CSP's
# connect-src (e.g. a model bucket on its own domain). S3 and CloudFront
# (*.amazonaws.com, *.cloudfront.net) are already allowed.
# VITE_CSP_CONNECT_SRC=https://models.gym.goalcert.example
