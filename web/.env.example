# Development: where Vite forwards /v1 calls (the backend's `npm run dev`).
GYM_PLAN_API=http://localhost:8080

# Production build only: the backend's public URL, when the page is hosted
# on a different origin from the API. Leave unset if a reverse proxy serves
# /v1 on the same origin as this page.
# VITE_API_URL=https://api.gymplan.example
