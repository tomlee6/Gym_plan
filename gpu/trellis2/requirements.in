# Python packages for the TRELLIS.2 worker image, on top of the base image's
# PyTorch 2.6.0 / CUDA 12.4 / Python 3.11 (L-11).
#
# Edit this file, then run lock_requirements.py to rebuild requirements.lock,
# which the image installs with --require-hashes. Versions match Microsoft's
# own TRELLIS.2 demo Space (huggingface.co/spaces/microsoft/TRELLIS.2,
# requirements.txt at ebf60b20) wherever it pins one, since that is the
# combination Microsoft runs; Pillow there replaces setup.sh's pillow-simd.
#
# Only what generating a model needs: setup.sh's gradio, tensorboard,
# pandas, lpips, imageio and imageio-ffmpeg are for the demo, training and
# preview videos, and are left out.

transformers==4.57.3
kornia==0.8.2
timm==1.0.22
trimesh==4.10.1
zstandard==0.25.0
easydict==1.13
opencv-python-headless==4.12.0.88
tqdm==4.67.1
pillow==12.0.0

# Not pinned by the Space; locked at what resolves today.
einops          # flash-attn and BiRefNet
plyfile         # o-voxel and utils3d
scipy           # utils3d
moderngl        # utils3d declares it (imported only for its OpenGL rasteriser, never here)
huggingface-hub
hf-xet          # huggingface-hub's download backend on x86_64; named here so a lock made on Windows includes it
safetensors
ninja           # builds the CUDA extensions
wheel           # flash-attn's and the extensions' builds import it
boto3           # the worker reads its input and writes the model to S3 (L-13)
