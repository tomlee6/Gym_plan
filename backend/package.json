{
  "name": "gym-plan-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Gym Plan backend: accounts, facilities, plans and scan uploads for the Flex Gym Scan app.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/**/*.test.js\"",
    "worker": "node src/worker.js",
    "dev:worker": "node --watch --env-file-if-exists=.env src/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1154.0",
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/client-sesv2": "^3.1148.0",
    "@aws-sdk/client-sqs": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  }
}
