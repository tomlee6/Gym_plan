# Used by `npm test`. Points at the gymplan_test database in the docker
# compose MySQL; the tests drop and recreate its tables.
NODE_ENV=test
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3317
DB_USER=gymplan
DB_PASSWORD=gymplan-dev
DB_NAME=gymplan_test
JWT_SECRET=test-jwt-secret-not-for-production
STORAGE_SIGNING_SECRET=test-storage-secret-not-for-production
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/test-storage
UPLOAD_URL_TTL_SECONDS=21600
ALLOW_SIMULATED_SCANS=true
