# Copy to .env and adjust. Never commit .env.
# In AWS every value comes from the task definition (infra/lib/api-stack.ts).

PORT=8080

# Public base URL of this API, used to build local storage upload URLs.
# Use your machine's LAN IP when testing on a phone.
PUBLIC_API_URL=http://localhost:8080
# Base URL of the web app. Walkthrough and share links are built from it
# whenever they are shown, never stored.
PUBLIC_WEB_URL=http://localhost:3000

# MySQL 8.4 (docker compose default: port 3317).
DB_HOST=127.0.0.1
DB_PORT=3317
DB_USER=gymplan
DB_PASSWORD=gymplan-dev
DB_NAME=gymplan
# RDS requires TLS; the container image sets DB_SSL_CA to Amazon's bundle.
DB_SSL=false
# DB_SSL_CA=/app/rds-global-bundle.pem

# Signs access tokens and local upload URLs. Use long random strings:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
STORAGE_SIGNING_SECRET=change-me-too
ACCESS_TOKEN_TTL_SECONDS=1800

# Session rules (B-06): web for the tab, up to a working day; the phone on a
# 60-day sliding token in the Keychain, up to 180 days.
WEB_SESSION_IDLE_DAYS=1
WEB_SESSION_ABSOLUTE_HOURS=12
IOS_SESSION_IDLE_DAYS=60
IOS_SESSION_ABSOLUTE_DAYS=180
INVITE_TTL_DAYS=14

# GoalCert Hub sign-in (B-01). `dev` serves a stand-in Hub at /dev-hub that
# lists the seeded people; `oidc` is the real Hub (production).
HUB_DRIVER=dev
# For HUB_DRIVER=oidc (values from the GoalCert team, N-02):
# HUB_ISSUER=https://hub.goalcert.example
# HUB_AUTHORIZE_URL=https://hub.goalcert.example/oauth/authorize
# HUB_TOKEN_URL=https://hub.goalcert.example/oauth/token
# HUB_JWKS_URL=https://hub.goalcert.example/.well-known/jwks.json
# HUB_CLIENT_ID=flex-gym
# HUB_CLIENT_SECRET=
# HUB_ORG_ID=flex-gym
# HUB_EVENTS_SECRET=
# HUB_WEB_REDIRECT_URI=http://localhost:3000/auth/callback
# HUB_IOS_REDIRECT_URI=flexgymscan://auth/callback

# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
# Signed part URLs must outlive iOS's 4-hour background transfer window.
UPLOAD_URL_TTL_SECONDS=21600
# Only for STORAGE_DRIVER=s3. Credentials come from the standard AWS chain.
S3_BUCKET=
S3_REGION=ap-southeast-2
AWS_REGION=ap-southeast-2

# Background jobs (E-01): db = the worker polls MySQL (run `npm run dev:worker`
# beside `npm run dev`); sqs = through SQS in AWS.
QUEUE_DRIVER=db
# JOBS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/flexgym-dev-jobs
JOB_MAX_ATTEMPTS=5
RETENTION_DAYS=90
WORKER_HEALTH_PORT=8081

# Until the 3D generator worker (J-01) is installed, `placeholder` marks an
# approved plan ready and the viewer builds the 3D in the browser.
GENERATOR_DRIVER=placeholder
GENERATOR_VERSION=browser-0

# Email (D-07): log | ses
MAIL_DRIVER=log
MAIL_FROM=Flex Gym Scan <no-reply@flexgym.example>
# SES_CONFIGURATION_SET=

# Debug builds of the app can submit a simulated scan (no LiDAR). Refused in
# production.
ALLOW_SIMULATED_SCANS=true
