# Copy to .env and adjust. Never commit .env.

PORT=8080

# Public base URL of this API, used to build local storage upload URLs and
# share links. Use your machine's LAN IP when testing on a phone.
PUBLIC_API_URL=http://localhost:8080
# Base URL of the web walkthrough viewer (GoalCert module).
PUBLIC_WEB_URL=http://localhost:3000

# MySQL (docker compose default: port 3317).
DB_HOST=127.0.0.1
DB_PORT=3317
DB_USER=gymplan
DB_PASSWORD=gymplan-dev
DB_NAME=gymplan

# Signs access tokens and local upload URLs. Use long random strings:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
STORAGE_SIGNING_SECRET=change-me-too

# Access tokens are short-lived; the app refreshes them (the architecture doc
# asks for a refresh every 30 minutes).
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=30

# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
# Signed part URLs must outlive iOS's 4-hour background transfer window.
UPLOAD_URL_TTL_SECONDS=21600

# Only for STORAGE_DRIVER=s3. Credentials come from the standard AWS chain
# (environment, shared config, or instance role).
S3_BUCKET=
S3_REGION=eu-west-2

# Debug builds of the app can submit a simulated scan (no LiDAR). Refuse them
# in production.
ALLOW_SIMULATED_SCANS=true
